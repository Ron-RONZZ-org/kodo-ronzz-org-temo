<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=VT323&display=swap">
    <link rel="stylesheet" href="{{asset "built/screen.css"}}">

    {{ghost_head}}
</head>

<body class="{{body_class}}{{block "body_class"}}">
<div class="site">

    <header id="gh-head" class="gh-head gh-outer">
        <div class="gh-head-inner gh-inner">
            <!-- Left: Logo -->
            <div class="gh-head-brand">
                <a class="gh-head-logo" href="{{@site.url}}">
                    {{#if @site.logo}}
                        <img src="{{@site.logo}}" alt="{{@site.title}}">
                    {{else}}
                        {{@site.title}}
                    {{/if}}
                </a>
                <button class="gh-burger" aria-label="Toggle menu"></button>
            </div>

            <!-- Center: Search -->
            <div class="gh-head-center">
                <button class="gh-head-search-btn" aria-label="Search this site" data-ghost-search>
                    {{> "icons/search"}}
                    <span class="gh-head-search-label">Search</span>
                </button>
            </div>

            <!-- Right: Clock -->
            <div class="gh-head-actions">
                <div id="koda-clock" class="koda-clock" aria-live="polite" aria-label="Current time"></div>
            </div>
        </div>

        <!-- Navigation (shown when burger is open) -->
        <nav class="gh-head-menu" aria-label="Site navigation">
            {{navigation}}
        </nav>
    </header>

    <div class="site-content">
        {{{body}}}
    </div>

    <footer class="gh-foot gh-outer">
        <div class="gh-foot-inner gh-inner">
            <div class="gh-copyright">
                <p>&#169; {{date format="YYYY"}} Rong ZHOU</p>
                <p>Website under <a href="https://www.gnu.org/licenses/agpl-3.0.en.html" target="_blank" rel="noopener">AGPL 3.0</a> licence</p>
                <p>Content under <a href="https://creativecommons.org/licenses/by-nc/4.0/deed.en" target="_blank" rel="noopener">CC BY-NC 4.0</a> licence if NOT otherwise indicated</p>
            </div>
            <div class="gh-powered-by">
                Powered by <a href="https://ghost.org/" target="_blank" rel="noopener">Ghost</a>
            </div>
        </div>
    </footer>

</div>

{{#is "post, page"}}
    {{> "pswp"}}
{{/is}}

<script
    src="https://code.jquery.com/jquery-3.3.1.min.js"
    integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8="
    crossorigin="anonymous">
</script>
<script src="{{asset "built/main.min.js"}}"></script>

{{ghost_foot}}

</body>
</html>
